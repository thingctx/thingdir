{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "saref": "https://saref.etsi.org/core/",
      "om": "http://www.ontology-of-units-of-measure.org/resource/om-2/"
    }
  ],
  "id": "urn:dev:pump:coolant-7",
  "title": "Coolant Pump 7",
  "@type": ["saref:Actuator", "saref:Sensor"],
  "securityDefinitions": { "basic_sc": { "scheme": "basic" } },
  "security": ["basic_sc"],
  "properties": {
    "pressure": {
      "@type": "saref:Pressure",
      "type": "number", "unit": "om:bar", "readOnly": true,
      "forms": [{ "href": "https://pump-7.local/pressure" }]
    },
    "power": {
      "@type": "saref:Power",
      "type": "number", "unit": "om:watt", "readOnly": true,
      "forms": [{ "href": "https://pump-7.local/power" }]
    },
    "state": {
      "@type": "saref:OnOffState",
      "type": "string", "enum": ["on", "off"],
      "forms": [{ "href": "https://pump-7.local/state" }]
    }
  },
  "actions": {
    "setSpeed": {
      "@type": "saref:ActuatingFunction",
      "input": { "type": "number", "minimum": 0, "maximum": 3000 },
      "forms": [{ "href": "https://pump-7.local/set-speed", "htv:methodName": "POST" }]
    }
  },
  "events": {
    "overheat": {
      "data": { "type": "object" },
      "forms": [{ "href": "mqtt://pump-7.local/overheat", "op": "subscribeevent" }]
    }
  }
}
